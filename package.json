{
  "name": "lenke-bank",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "concurrently \"npm run build -w client\" \"npm run build -w server\"",
    "test": "npx tsx --env-file=.env --test server/Test/**/*.test.ts",
    "test:integration": "npx tsx --env-file=.env --test server/Test/Integration/*.test.ts",
    "test:unit": "npx tsx --test server/Test/Unit/*.test.ts",
    "test:smoke": "npx tsx --env-file=.env --test server/Test/Smoke/*.test.ts",
    "database:generate": "drizzle-kit generate",
    "database:up": "drizzle-kit up",
    "database:migrate": "drizzle-kit migrate",
    "database:push": "drizzle-kit push",
    "database:pull": "drizzle-kit pull",
    "database:studio": "drizzle-kit studio",
    "generate-secret": "npm run generate-secret -w server"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^10.0.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "tippy.js": "^6.3.7"
  }
}
